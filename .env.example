# LLM provider config
#
# The app speaks the Anthropic Messages API, so it runs against Anthropic
# directly or against any gateway that implements it.
#
# Anthropic directly:   leave ANTHROPIC_BASE_URL unset.
# A gateway (AgentRouter, etc.): set ANTHROPIC_BASE_URL to its host. The key is
#   still read from ANTHROPIC_API_KEY. Omitting the base URL sends a gateway key
#   to api.anthropic.com, which fails authentication.
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://agentrouter.org

# Must be a model the configured endpoint actually serves, or the first question
# returns 503. AgentRouter: claude-opus-5, claude-opus-4-8, gpt-5.6-sol.
LLM_MODEL=claude-opus-5

# Adaptive evaluation (experimental, off by default). When on, every answer is
# graded by the model against the day's objectives, the grade decides whether
# to probe deeper, and per-day mastery beliefs update as the interview runs.
# When off (or on any grading failure) the engine uses its original heuristic.
# Grading adds one model call per turn, roughly doubling per-question latency.
# ENABLE_ADAPTIVE_EVAL=1

# App
APP_HOST=127.0.0.1
APP_PORT=8000
